{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://expense-tracker.infinityfree.me/expense-tracker/tracker/backend/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite"
}