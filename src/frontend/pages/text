.modal {
  position: fixed;
  z-index: 1000;
  width: 100%;
  height: 100%;
}

.modal-content {
  background: white;
  padding: 20px;
  border-radius: 10px;
  width: 300px;
  position: relative;
}

/* Modal box */
#modalForm {
  background: #fff;
  padding: 25px;
  border-radius: 12px;
  width: 320px;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
  gap: 15px;
  
}

/* Heading */
.modal p {
  position: absolute;
  top: 20%;
  font-size: 18px;
  font-weight: bold;
  color: #333;
}


#modalForm input,
#modalForm select {
  width: 100%;
  padding: 10px;
  border-radius: 6px;
  border: 1px solid #ccc;
  outline: none;
  font-size: 14px;
}

#modalForm input:focus,
#modalForm select:focus {
  border-color: #6a11cb;
}

